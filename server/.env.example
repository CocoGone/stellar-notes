# 复制成 .env 后填写。

# PostgreSQL。本地开发先运行 npm run db:up（用本机 PostgreSQL 起一个项目内的库，端口 54329）
DATABASE_URL=postgres://stellar:stellar@127.0.0.1:54329/stellar_notes

# 大模型：Anthropic Messages API，也可以指向 LiteLLM 等兼容网关。
# 不填时 App 仍可使用：宫位解读用规则版，追问只列依据，今日一图不识图。
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://your-litellm-gateway.example.com
# XJ_MODEL=claude-opus-5-5
# 直连 Anthropic 时默认开启服务端拒答回退（fallbacks: "default"）；配置了 ANTHROPIC_BASE_URL 时默认关闭
# XJ_FALLBACKS=default

# PORT=8787
# HOST=127.0.0.1

# 大模型：填了 DEEPSEEK_API_KEY 就用 DeepSeek（宫位解读、每日一图用 deepseek-flash，追问用 deepseek-v4-pro）；
# 不填就用 ANTHROPIC_API_KEY。XJ_PROVIDER 可强制指定 deepseek / anthropic。
XJ_PROVIDER=
DEEPSEEK_API_KEY=
